@page "/teacher/przedmioty"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using wirtualny_dziekanat.Data.Entities
@using wirtualny_dziekanat.Services
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer

@inject ITeacherService TeacherService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Moje Przedmioty</PageTitle>

<div class="mb-4">
    <p class="text-primary text-uppercase fw-semibold mb-1">Strefa nauczyciela</p>
    <h1 class="display-6 fw-bold mb-1">Moje przedmioty</h1>
    <p class="text-muted mb-0">Zarządzaj ocenami studentów zapisanych na prowadzonych przedmiotach.</p>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (isLoading)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-muted">Ładowanie przedmiotów...</div></div>
}
else if (subjects.Count == 0)
{
    <div class="alert alert-info">Nie masz jeszcze przypisanych żadnych przedmiotów.</div>
}
else
{
    <div class="accordion" id="teacherSubjectsAccordion">
        @foreach (var subject in subjects)
        {
            var accordionId = $"subject-{subject.Id}";
            <div class="accordion-item border-0 shadow-sm mb-3" @key="subject.Id">
                <h2 class="accordion-header" id="heading-@subject.Id">
                    <button class="accordion-button @(expandedSubjectId == subject.Id ? string.Empty : "collapsed")" type="button" @onclick="() => ToggleSubject(subject.Id)">
                        <span class="fw-semibold">@subject.Nazwa</span>
                        <span class="badge text-bg-primary ms-3">Semestr @subject.Semestr</span>
                        <span class="badge text-bg-secondary ms-3">@subject.PunktyECTS ECTS</span>
                    </button>
                </h2>
                @if (expandedSubjectId == subject.Id)
                {
                    <div id="@accordionId" class="accordion-collapse show">
                        <div class="accordion-body">
                            @if (subject.Enrollments.Count == 0)
                            {
                                <p class="text-muted mb-0">Na ten przedmiot nie zapisał się jeszcze żaden student.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Imię</th>
                                                <th>Nazwisko</th>
                                                <th>Numer indeksu</th>
                                                <th>Aktualny semestr</th>
                                                <th>Aktualna ocena</th>
                                                <th class="text-end">Akcja</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var enrollment in subject.Enrollments.OrderBy(item => item.Student.Nazwisko).ThenBy(item => item.Student.Imie))
                                            {
                                                var latestGrade = enrollment.Grades.OrderByDescending(grade => grade.DataWystawienia).FirstOrDefault();
                                                <tr @key="enrollment.Id">
                                                    <td>@enrollment.Student.Imie</td>
                                                    <td>@enrollment.Student.Nazwisko</td>
                                                    <td>@enrollment.Student.NumerIndeksu</td>
                                                    <td>
                                                        @if (latestGrade is null)
                                                        {
                                                            <span class="text-muted">Brak oceny</span>
                                                        }
                                                        else
                                                        {
                                                            @latestGrade.WartoscOceny.ToString("0.0")
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="d-inline-flex align-items-center gap-2">
                                                            <input type="number" class="form-control form-control-sm grade-input" step="0.5" min="2.0" max="5.0" value="@GetGradeValue(enrollment)" @onchange="eventArgs => SetGradeValue(enrollment.Id, eventArgs.Value)" />
                                                            <button type="button" class="btn btn-sm btn-primary" disabled="@(savingEnrollmentId is not null)" @onclick="() => SaveGradeAsync(enrollment.Id)">
                                                                @(savingEnrollmentId == enrollment.Id ? "Zapisywanie..." : "Zapisz ocenę")
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    .grade-input {
        max-width: 90px;
    }
</style>

@code {
    private List<Subject> subjects = [];
    private readonly Dictionary<int, decimal?> gradeValues = [];
    private int? expandedSubjectId;
    private int? savingEnrollmentId;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var teacherUserId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(teacherUserId))
            {
                errorMessage = "Nie można ustalić tożsamości nauczyciela.";
                return;
            }

            subjects = await TeacherService.GetTeacherSubjectsWithDetailsAsync(teacherUserId);
            InitializeGradeValues();
        }
        catch (Exception exception)
        {
            errorMessage = GetErrorMessage(exception, "Nie udało się pobrać przedmiotów.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSubject(int subjectId)
    {
        expandedSubjectId = expandedSubjectId == subjectId ? null : subjectId;
    }

    private decimal? GetGradeValue(Enrollment enrollment)
    {
        if (gradeValues.TryGetValue(enrollment.Id, out var value))
        {
            return value;
        }

        return enrollment.Grades
            .OrderByDescending(grade => grade.DataWystawienia)
            .Select(grade => (decimal?)grade.WartoscOceny)
            .FirstOrDefault();
    }

    private void SetGradeValue(int enrollmentId, object? value)
    {
        gradeValues[enrollmentId] = decimal.TryParse(value?.ToString(), out var grade) ? grade : null;
    }

    private async Task SaveGradeAsync(int enrollmentId)
    {
        if (!gradeValues.TryGetValue(enrollmentId, out var grade) || grade is null)
        {
            errorMessage = "Podaj ocenę w zakresie od 2,0 do 5,0.";
            successMessage = null;
            return;
        }

        savingEnrollmentId = enrollmentId;
        errorMessage = null;
        successMessage = null;
        try
        {
            await TeacherService.SaveGradeAsync(enrollmentId, grade.Value);
            successMessage = "Ocena została zapisana.";
            await ReloadSubjectsAsync();
        }
        catch (Exception exception)
        {
            errorMessage = GetErrorMessage(exception, "Nie udało się zapisać oceny.");
        }
        finally
        {
            savingEnrollmentId = null;
        }
    }

    private async Task ReloadSubjectsAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var teacherUserId = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(teacherUserId))
        {
            return;
        }

        subjects = await TeacherService.GetTeacherSubjectsWithDetailsAsync(teacherUserId);
        InitializeGradeValues();
    }

    private void InitializeGradeValues()
    {
        gradeValues.Clear();
        foreach (var enrollment in subjects.SelectMany(subject => subject.Enrollments))
        {
            gradeValues[enrollment.Id] = enrollment.Grades
                .OrderByDescending(grade => grade.DataWystawienia)
                .Select(grade => (decimal?)grade.WartoscOceny)
                .FirstOrDefault();
        }
    }

    private static string GetErrorMessage(Exception exception, string fallback) =>
        exception is ArgumentOutOfRangeException or InvalidOperationException ? exception.Message : fallback;
}

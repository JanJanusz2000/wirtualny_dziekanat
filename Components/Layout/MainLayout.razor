@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <AuthorizeView Context="authContext">
                <Authorized>
                    <span class="text-muted me-3">
                        Witaj, <strong>@authContext.User.Identity?.Name</strong>
                    </span>
                    <form action="/Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken />
                        @* Endpoint Identity akceptuje wyłącznie lokalną ścieżkę powrotu. *@
                        <input type="hidden" name="ReturnUrl" value="/" />
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            Wyloguj
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary btn-sm" href="Account/Login">
                        Zaloguj się
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

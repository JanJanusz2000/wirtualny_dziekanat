@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using wirtualny_dziekanat.Data
@using wirtualny_dziekanat.Data.Entities
@using wirtualny_dziekanat.Services

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject IdentityRedirectManager RedirectManager
@inject IAdminService AdminService

<PageTitle>Zapis na studia</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">
                <p class="text-primary text-uppercase fw-semibold mb-1">Rekrutacja</p>
                <h1 class="h3 mb-2">Zapisz się na studia</h1>
                <p class="text-muted mb-4">
                    Uzupełnij dane, aby utworzyć konto studenta w Wirtualnym Dziekanacie.
                </p>

                @if (!string.IsNullOrWhiteSpace(registrationError))
                {
                    <div class="alert alert-danger" role="alert">@registrationError</div>
                }

                <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="firstName" class="form-label">Imię</label>
                            <InputText id="firstName" class="form-control" @bind-Value="Input.Imie" autocomplete="given-name" />
                            <ValidationMessage For="@(() => Input.Imie)" class="text-danger" />
                        </div>
                        <div class="col-md-6">
                            <label for="lastName" class="form-label">Nazwisko</label>
                            <InputText id="lastName" class="form-control" @bind-Value="Input.Nazwisko" autocomplete="family-name" />
                            <ValidationMessage For="@(() => Input.Nazwisko)" class="text-danger" />
                        </div>
                        <div class="col-12">
                            <label for="direction" class="form-label">Kierunek studiów</label>
                            <InputSelect id="direction" class="form-select" @bind-Value="Input.KierunekId">
                                <option value="0">-- wybierz kierunek --</option>
                                @foreach (var direction in directions)
                                {
                                    <option value="@direction.Id">@direction.Nazwa</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => Input.KierunekId)" class="text-danger" />
                        </div>
                        <div class="col-12">
                            <label for="studyMode" class="form-label">Tryb studiów</label>
                            <InputSelect id="studyMode" class="form-select" @bind-Value="Input.TrybStudiow">
                                <option value="">-- wybierz tryb --</option>
                                <option value="Dzienne">Dzienne</option>
                                <option value="Zaoczne">Zaoczne</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => Input.TrybStudiow)" class="text-danger" />
                        </div>
                        <div class="col-md-6">
                            <label for="password" class="form-label">Hasło</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="Input.Password" autocomplete="new-password" />
                            <ValidationMessage For="@(() => Input.Password)" class="text-danger" />
                        </div>
                        <div class="col-md-6">
                            <label for="confirmPassword" class="form-label">Powtórz hasło</label>
                            <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
                            <ValidationMessage For="@(() => Input.ConfirmPassword)" class="text-danger" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-4" disabled="@isSubmitting">
                        @(isSubmitting ? "Tworzenie konta..." : "Zarejestruj się")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Kierunek> directions = [];
    private bool isSubmitting;
    private string? registrationError;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        await using var context = await ContextFactory.CreateDbContextAsync();
        directions = await context.Kierunki
            .AsNoTracking()
            .OrderBy(direction => direction.Nazwa)
            .ToListAsync();
    }

    private async Task RegisterUser()
    {
        isSubmitting = true;
        registrationError = null;

        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();

            var groupId = await context.Grupy
                .Where(group => group.KierunekId == Input.KierunekId)
                .OrderBy(group => group.Id)
                .Select(group => (int?)group.Id)
                .FirstOrDefaultAsync();

            if (groupId is null)
            {
                registrationError = "Wybrany kierunek nie ma jeszcze przypisanej grupy. Skontaktuj się z administratorem.";
                return;
            }

            var indexes = await context.Students
                .AsNoTracking()
                .Select(student => student.NumerIndeksu)
                .ToListAsync();

            const int firstIndex = 100000;
            var highestIndex = indexes
                .Select(index => int.TryParse(index, out var number) ? number : 0)
                .DefaultIfEmpty(firstIndex - 1)
                .Max();
            var indexNumber = Math.Max(firstIndex, highestIndex + 1);
            var index = indexNumber.ToString(CultureInfo.InvariantCulture);
            var email = $"{index}@student.uczelnia.pl";

            var user = new ApplicationUser
            {
                UserName = email,
                Email = email,
                EmailConfirmed = true
            };

            var createResult = await UserManager.CreateAsync(user, Input.Password);
            if (!createResult.Succeeded)
            {
                registrationError = FormatIdentityErrors(createResult);
                return;
            }

            try
            {
                if (!await RoleManager.RoleExistsAsync("Student"))
                {
                    var roleResult = await RoleManager.CreateAsync(new IdentityRole("Student"));
                    if (!roleResult.Succeeded)
                    {
                        registrationError = FormatIdentityErrors(roleResult);
                        await UserManager.DeleteAsync(user);
                        return;
                    }
                }

                var userRoleResult = await UserManager.AddToRoleAsync(user, "Student");
                if (!userRoleResult.Succeeded)
                {
                    registrationError = FormatIdentityErrors(userRoleResult);
                    await UserManager.DeleteAsync(user);
                    return;
                }

                var student = new Student
                {
                    ApplicationUserId = user.Id,
                    NumerIndeksu = index,
                    Imie = Input.Imie.Trim(),
                    Nazwisko = Input.Nazwisko.Trim(),
                    Semestr = 1,
                    KierunekId = Input.KierunekId,
                    GrupaId = groupId.Value,
                    TrybStudiow = Input.TrybStudiow,
                    CzyCzesneOplacone = false
                };
                context.Students.Add(student);
                await context.SaveChangesAsync();
                await AdminService.AutoEnrollStudentAsync(student.Id);
            }
            catch
            {
                await UserManager.DeleteAsync(user);
                throw;
            }

            await SignInManager.SignInAsync(user, isPersistent: false);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        catch (Exception exception)
        {
            registrationError = $"Nie udało się utworzyć konta: {exception.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string FormatIdentityErrors(IdentityResult result) =>
        string.Join(" ", result.Errors.Select(error => error.Description));

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Imię jest wymagane.")]
        [StringLength(100)]
        public string Imie { get; set; } = string.Empty;

        [Required(ErrorMessage = "Nazwisko jest wymagane.")]
        [StringLength(100)]
        public string Nazwisko { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Wybierz kierunek studiów.")]
        public int KierunekId { get; set; }

        [Required(ErrorMessage = "Wybierz tryb studiów.")]
        [RegularExpression("^(Dzienne|Zaoczne)$", ErrorMessage = "Wybierz poprawny tryb studiów.")]
        public string TrybStudiow { get; set; } = string.Empty;

        [Required(ErrorMessage = "Hasło jest wymagane.")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Hasło musi mieć od 6 do 100 znaków.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Hasła muszą być identyczne.")]
        [DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}